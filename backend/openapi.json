        "required": [
          "rank",
          "score",
          "scientific_name",
          "scientific_name_without_author",
          "genus",
          "family",
          "common_names",
          "gbif_id",
          "powo_id"
        ],
        "title": "IdentifyResultOut",
        "type": "object"
