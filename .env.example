# Copy to .env and fill in. .env is git-ignored.
# compose.yaml reads these for interpolation; every var has a safe default.
# See docs/plantnet-api.md for how the key is used.

# Real key, only needed for the manual real-API smoke run.
PLANTNET_API_KEY=

# Do NOT set PLANTNET_BASE_URL here: compose and the backend default to the fake server.
# For a manual real-API run:  PLANTNET_BASE_URL=https://my-api.plantnet.org podman compose up -d

POSTGRES_USER=yvoty
POSTGRES_PASSWORD=yvoty
POSTGRES_DB=yvoty
# Host-side backend runs (uv run pytest/uvicorn) use this URL: update it if you change
# POSTGRES_USER/PASSWORD/DB above (compose builds its own URL for the container).
# DATABASE_URL=postgresql+psycopg://yvoty:yvoty@localhost:5432/yvoty

S3_ACCESS_KEY=yvoty
S3_SECRET_KEY=yvoty-secret
S3_BUCKET=yvoty-photos

# Auth. Any >=32-byte random string; the default is for local dev only.
# JWT_SECRET=
# Browser origins allowed to call the API (Flutter web on :8080 for e2e and `flutter run --web-port 8080`).
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
